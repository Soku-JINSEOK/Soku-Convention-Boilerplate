{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ci-cd-decision-v1",
  "title": "Portable Soku CI/CD decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "source_host",
    "workload",
    "artifact",
    "required_os",
    "network_scope",
    "cloud_authority",
    "operations_owner",
    "capabilities",
    "verification",
    "delivery"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "const": "ci-only" },
    "source_host": { "enum": ["github", "github.com", "gitlab", "gitlab.com"] },
    "workload": {
      "enum": ["api", "container-service", "desktop-app", "iac", "library", "mobile-app", "static-site", "template"]
    },
    "artifact": { "enum": ["archive", "container-digest", "installer", "none", "package"] },
    "required_os": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["darwin", "linux", "windows"] }
    },
    "network_scope": {
      "enum": ["gcp-private", "isolated", "none", "on-premises", "private-vpc", "public"]
    },
    "cloud_authority": { "enum": ["aws", "azure", "gcp", "none"] },
    "operations_owner": { "enum": ["declared", "absent"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "full"],
      "properties": {
        "pr": { "const": "ci-quick" },
        "full": { "const": "full" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "const": false } }
    }
  }
}
